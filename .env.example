# fanpage-content-create — env vars. Copy to `.env` and fill in real values
# before go-live. Nothing here is a real secret — placeholders only.

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Postgres (Drizzle) ----
# Local dev via `docker compose up`: postgres://fanpage:fanpage@localhost:5432/fanpage
DATABASE_URL="postgres://user:password@localhost:5432/fanpage_content_create"

# ---- Auth (HMAC login tokens, 7-day expiry) ----
# >= 16 chars, random. Required — server refuses to start login flow without it.
AUTH_SECRET="change-me-to-a-random-32-char-secret"

# One-time seed: creates the first admin account in `users` (see server/db/seed.ts).
# Set both, run `npm run db:seed`, then you may clear these from your real .env.
ADMIN_SEED_USERNAME=""
ADMIN_SEED_PASSWORD=""

# ---- Market Radar MCP (THU — đọc tín hiệu marketing-kd + ke-toan) ----
# HTTP JSON-RPC 2.0 endpoint. CHƯA CÓ — cần user cung cấp trước go-live thật.
# Khi thiếu, server fallback sang demo/seed signals (log warning, không crash).
MARKET_RADAR_MCP_URL=""   # endpoint nội bộ — hỏi người quản trị
MARKET_RADAR_MCP_TOKEN=""

# ---- Group Insights MCP (THU — đọc cluster group Facebook) ----
# CHƯA CÓ — cần user cung cấp trước go-live thật. Fallback demo khi thiếu.
GROUP_INSIGHTS_MCP_URL=""  # endpoint nội bộ — hỏi người quản trị
GROUP_INSIGHTS_MCP_TOKEN=""

# ---- Đăng nhập Google (SSO — server/services/google-auth.ts) ----
# Tạo OAuth 2.0 Client ID (Web application) trong Google Cloud Console
# (https://console.cloud.google.com → APIs & Services → Credentials).
# - Authorized JavaScript origins: https://fanpage-content-create.mk.dev.matbao.ai
#   (+ http://localhost:3001 nếu chạy dev). KHÔNG cần redirect URI (dùng ID token).
# GOOGLE_CLIENT_ID: server verify ID token. VITE_GOOGLE_CLIENT_ID: frontend render
# nút Google (PHẢI cùng giá trị; biến VITE_* mới lộ ra client — an toàn vì client ID
# không phải bí mật). Thiếu 2 biến này → trang login ẩn nút Google, vẫn login nội bộ được.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""
# GOOGLE_ADMIN_EMAILS: email được set admin NGAY khi đăng nhập Google (phân tách dấu
# phẩy). Tài khoản đầu tiên/khẩn cấp. Các email khác do admin cấp quyền trong app.
GOOGLE_ADMIN_EMAILS=""    # email được cấp quyền quản trị ngay khi đăng nhập Google

# ---- MCP server "Tín hiệu" (Claude làm AI Analyst — server/routes/mcp-signals.routes.ts) ----
# Fanpage EXPOSE 1 MCP server để Claude (claude.ai remote connector qua OAuth,
# hoặc Claude Desktop/Code bằng static token) tự THU tin web/news, gom cụm, chấm
# điểm kèm lý do, gợi ý góc hài. Kết quả hiện ở tab Tín hiệu.
# - JWT_SECRET: ký OAuth code/token (BẮT BUỘC để OAuth hoạt động). Thiếu → dùng
#   AUTH_SECRET. Đặt 1 chuỗi ngẫu nhiên >=32 ký tự, giữ ổn định (đổi = huỷ mọi token).
JWT_SECRET=""
# - SIGNALS_MCP_TOKEN: static bearer token (tuỳ chọn) để Claude Desktop/Code/test
#   kết nối không cần OAuth. Để TRỐNG nếu chỉ dùng OAuth qua claude.ai.
SIGNALS_MCP_TOKEN=""
# LƯU Ý DEPLOY: để claude.ai (web) gọi được, các path /api/mcp-signals,
# /.well-known/* và /api/oauth/* phải reachable PUBLIC (miễn IP-allowlist
# matbao-local) — cần manager approval. Nội bộ (Claude Code trong allowlist) thì
# dùng SIGNALS_MCP_TOKEN được ngay.

# ---- Gemini trực tiếp (DỊCH + VẼ — server/services/gemini-direct.ts) ----
# Google AI Studio API key (https://aistudio.google.com/apikey). Gọi Gemini
# TRỰC TIẾP từ server (pattern y hệt share-projects/marcow-crop production),
# KHÔNG BAO GIỜ gửi ra client. Khi thiếu, server fallback sang kịch bản mẫu
# (template) / ảnh placeholder, đánh dấu rõ "demo" trong response, log
# warning, không crash toàn app.
GEMINI_API_KEY=""

# ---- social backend (KHÔNG còn dùng cho DỊCH/VẼ — xem GEMINI_API_KEY ở trên) ----
# Base URL nội bộ của share-projects/social. Giữ lại 2 biến này (không xoá
# khỏi schema/route khác) phòng khi cần tích hợp thêm việc khác với social
# backend sau này — endpoint DỊCH/VẼ cũ chưa từng xác nhận reachable.
SOCIAL_BACKEND_URL=""
SOCIAL_BACKEND_TOKEN=""

# ---- Object storage (ảnh reference nhân vật — server/storage.ts) ----
# Thư mục ghi file trên volume (Docker/Coolify mount). Default /data/uploads.
UPLOAD_DIR="/data/uploads"

# ---- Facebook Graph API (page "Ăn Nằm Với AI") ----
# iMVP: chỉ tham chiếu (ĐĂNG là thủ công) — không dùng để auto-post trong app.
# CHƯA CÓ — cần user cung cấp nếu Phase 2 tự động hoá bước ĐĂNG.
FB_PAGE_ID=""
FB_ACCESS_TOKEN=""

# ===== Bảo mật đăng nhập =====
# Domain email được phép TỰ đăng ký qua Google (tài khoản mới).
# Người đã được admin duyệt trước đó vẫn đăng nhập được kể cả ngoài domain.
# Nhiều domain: ngăn cách bằng dấu phẩy. Đặt "*" để tắt kiểm tra.
GOOGLE_ALLOWED_DOMAINS=matbao.com

# ===== Radar — bổ sung số liệu tương tác qua Apify =====
# Apify tính tiền theo LƯỢT CHẠY actor, nên mặc định đặt ngưỡng thấp.
# Thiếu APIFY_TOKEN thì app vẫn chạy: chỉ dùng số liệu quét miễn phí và
# đánh dấu độ tin cậy thấp, KHÔNG crash.
APIFY_TOKEN=""
# Giá đo thực tế 2026-09-18: ~$0.0035 mỗi kết quả (actor tính theo SỐ KẾT QUẢ,
# không phải theo lượt chạy). Gói STARTER hạn mức $29/tháng.
APIFY_ENRICH_LIMIT=25          # tối đa bao nhiêu bài được bổ sung số liệu mỗi phiên (~$0.09)
APIFY_CACHE_DAYS=7             # trong ngần này ngày thì đọc lại cache, không gọi mới
APIFY_DAILY_RUN_BUDGET=20      # trần số lượt chạy actor mỗi ngày
APIFY_DAILY_RESULT_BUDGET=150  # trần số KẾT QUẢ mỗi ngày (~$0.52/ngày, ~$15.8/tháng)
# Đổi actor mà không cần sửa code:
# APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
# APIFY_ACTOR_INSTAGRAM=apify~instagram-scraper
# APIFY_ACTOR_YOUTUBE=streamers~youtube-scraper

# ===== Cookie cho Douyin (f2) =====
# Đường dẫn tới file cookie định dạng Netscape (cookies.txt).
# KHÔNG commit file này. Xem docs/COOKIE-HUONG-DAN.md để biết cách lấy.
DOUYIN_COOKIES_FILE=".secrets/douyin-cookies.txt"
